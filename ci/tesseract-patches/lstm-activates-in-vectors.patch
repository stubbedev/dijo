+#if defined(TESS_ACTIVATIONS_NEON)
+template <Activation kind>
+void ActivateNEON(const float *in, const float *scale, int n, float *out) {
+  const float *table = kind == Activation::kTanh ? TanhTable : LogisticTable;
+  const float32x4_t factor = vdupq_n_f32(kScaleFactor);
+  const float32x4_t last_index = vdupq_n_f32(kTableSize - 2);
+  const float32x4_t saturated = vdupq_n_f32(kTableSize - 1);
+  const float32x4_t one = vdupq_n_f32(1.0f);
+  const float32x4_t zero = vdupq_n_f32(0.0f);
+  int i = 0;
+  for (; i + 4 <= n; i += 4) {
+    const float32x4_t x = vld1q_f32(in + i);
+    const float32x4_t scaled = vmulq_f32(vabsq_f32(x), factor);
+    const int32x4_t index = vcvtq_s32_f32(vminq_f32(scaled, last_index));
+    int32_t indices[4];
+    vst1q_s32(indices, index);
+    const float32x4_t low = vcombine_f32(vld1_f32(table + indices[0]), vld1_f32(table + indices[1]));
+    const float32x4_t high = vcombine_f32(vld1_f32(table + indices[2]), vld1_f32(table + indices[3]));
+    const float32x4_t i0 = vuzp1q_f32(low, high);
+    const float32x4_t i1 = vuzp2q_f32(low, high);
+    const float32x4_t fraction = vsubq_f32(scaled, vcvtq_f32_s32(index));
+    float32x4_t value = vfmaq_f32(i0, vsubq_f32(i1, i0), fraction);
+    value = vbslq_f32(vcgeq_f32(scaled, saturated), one, value);
+    const float32x4_t mirrored =
+        kind == Activation::kTanh ? vnegq_f32(value) : vsubq_f32(one, value);
+    value = vbslq_f32(vcltq_f32(x, zero), mirrored, value);
+    if (scale != nullptr) {
+      value = vmulq_f32(value, vld1q_f32(scale + i));
+    }
+    vst1q_f32(out + i, value);
+  }
+  ActivateScalar<kind>(in + i, scale == nullptr ? nullptr : scale + i, n - i, out + i);
+}
+#endif
+
+template <Activation kind>
+void Activate(const TFloat *in, const TFloat *scale, int n, TFloat *out) {
+#if defined(TESS_ACTIVATIONS_AVX2)
+  if (SIMDDetect::IsAVX2Available()) {
+    ActivateAVX2<kind>(in, scale, n, out);
+    return;
+  }
+#endif
+#if defined(TESS_ACTIVATIONS_NEON)
+  ActivateNEON<kind>(in, scale, n, out);
+#else
+  ActivateScalar<kind>(in, scale, n, out);
+#endif
+}
+
+} // namespace
+
+template <>
+void FuncInplace<GFunc>(int n, TFloat *inout) {
+  Activate<Activation::kTanh>(inout, nullptr, n, inout);
+}
+
+template <>
+void FuncInplace<HFunc>(int n, TFloat *inout) {
+  Activate<Activation::kTanh>(inout, nullptr, n, inout);
+}
+
+template <>
+void FuncInplace<FFunc>(int n, TFloat *inout) {
+  Activate<Activation::kLogistic>(inout, nullptr, n, inout);
+}
+
+template <>
+void FuncMultiply<HFunc>(const TFloat *u, const TFloat *v, int n, TFloat *out) {
+  Activate<Activation::kTanh>(u, v, n, out);
+}
+
 } // namespace tesseract.
