+namespace {
+
+enum class Activation { kTanh, kLogistic };
+
+template <Activation kind>
+using ActivationFunc = std::conditional_t<kind == Activation::kTanh, GFunc, FFunc>;
+
+template <Activation kind>
+void ActivateScalar(const TFloat *in, const TFloat *scale, int n, TFloat *out) {
+  ActivationFunc<kind> f;
+  if (scale == nullptr) {
+    for (int i = 0; i < n; ++i) {
+      out[i] = f(in[i]);
+    }
+    return;
+  }
+  for (int i = 0; i < n; ++i) {
+    out[i] = f(in[i]) * scale[i];
+  }
+}
