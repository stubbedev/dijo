+#if defined(TESS_ACTIVATIONS_AVX2)
+template <Activation kind>
+TESS_TARGET_AVX2 void ActivateAVX2(const float *in, const float *scale, int n, float *out) {
+  const float *table = kind == Activation::kTanh ? TanhTable : LogisticTable;
+  const __m256 sign = _mm256_set1_ps(-0.0f);
+  const __m256 factor = _mm256_set1_ps(kScaleFactor);
+  const __m256 last_index = _mm256_set1_ps(kTableSize - 2);
+  const __m256 saturated = _mm256_set1_ps(kTableSize - 1);
+  const __m256 one = _mm256_set1_ps(1.0f);
+  int i = 0;
+  for (; i + 8 <= n; i += 8) {
+    const __m256 x = _mm256_loadu_ps(in + i);
+    const __m256 scaled = _mm256_mul_ps(_mm256_andnot_ps(sign, x), factor);
+    const __m256i index = _mm256_cvttps_epi32(_mm256_min_ps(scaled, last_index));
+    alignas(32) int indices[8];
+    _mm256_store_si256(reinterpret_cast<__m256i *>(indices), index);
+    const auto pairs = [&](int a, int b) {
+      const __m128d low = _mm_load_sd(reinterpret_cast<const double *>(table + indices[a]));
+      return _mm_loadh_pd(low, reinterpret_cast<const double *>(table + indices[b]));
+    };
+    const __m256 even = _mm256_castpd_ps(_mm256_set_m128d(pairs(4, 5), pairs(0, 1)));
+    const __m256 odd = _mm256_castpd_ps(_mm256_set_m128d(pairs(6, 7), pairs(2, 3)));
+    const __m256 i0 = _mm256_shuffle_ps(even, odd, _MM_SHUFFLE(2, 0, 2, 0));
+    const __m256 i1 = _mm256_shuffle_ps(even, odd, _MM_SHUFFLE(3, 1, 3, 1));
+    const __m256 fraction = _mm256_sub_ps(scaled, _mm256_cvtepi32_ps(index));
+    __m256 value = _mm256_add_ps(i0, _mm256_mul_ps(_mm256_sub_ps(i1, i0), fraction));
+    value = _mm256_blendv_ps(value, one, _mm256_cmp_ps(scaled, saturated, _CMP_GE_OQ));
+    const __m256 mirrored =
+        kind == Activation::kTanh ? _mm256_xor_ps(value, sign) : _mm256_sub_ps(one, value);
+    value = _mm256_blendv_ps(value, mirrored, _mm256_cmp_ps(x, _mm256_setzero_ps(), _CMP_LT_OQ));
