+template <typename T>
+void StackWindows(const StrideMap &stride_map, int half_x, int half_y, int ni, const T *src,
+                  int src_features, T *dest, int dest_features, NetworkIO *output,
+                  TRand *randomizer) {
+  const int y_scale = 2 * half_y + 1;
+  const int x_step = StrideMap::Index(stride_map, 0, 0, 1).t();
+  const int y_step = StrideMap::Index(stride_map, 0, 1, 0).t();
+  std::vector<ptrdiff_t> offsets;
+  for (int x = -half_x; x <= half_x; ++x) {
+    for (int y = -half_y; y <= half_y; ++y) {
+      offsets.push_back(static_cast<ptrdiff_t>(x * x_step + y * y_step) * src_features);
+    }
+  }
+  StrideMap::Index dest_index(stride_map);
+  do {
+    const int t = dest_index.t();
+    const int dest_x = dest_index.index(FD_WIDTH);
+    const int dest_y = dest_index.index(FD_HEIGHT);
+    const int max_x = dest_index.MaxIndexOfDim(FD_WIDTH);
+    const int max_y = dest_index.MaxIndexOfDim(FD_HEIGHT);
+    const T *src_line = src + static_cast<ptrdiff_t>(t) * src_features;
+    T *dest_line = dest + static_cast<ptrdiff_t>(t) * dest_features;
+    if (dest_x >= half_x && dest_x + half_x <= max_x && dest_y >= half_y &&
+        dest_y + half_y <= max_y) {
+      for (ptrdiff_t offset : offsets) {
+        dest_line = std::copy_n(src_line + offset, ni, dest_line);
+      }
+      continue;
+    }
+    int k = 0;
+    for (int x = -half_x; x <= half_x; ++x) {
+      if (dest_x + x < 0 || dest_x + x > max_x) {
+        output->Randomize(t, k * ni, y_scale * ni, randomizer);
+        k += y_scale;
+        continue;
+      }
+      for (int y = -half_y; y <= half_y; ++y, ++k) {
+        if (dest_y + y < 0 || dest_y + y > max_y) {
+          output->Randomize(t, k * ni, ni, randomizer);
+        } else {
+          std::copy_n(src_line + offsets[k], ni, dest_line + k * ni);
+        }
+      }
+    }
+  } while (dest_index.Increment());
+}
