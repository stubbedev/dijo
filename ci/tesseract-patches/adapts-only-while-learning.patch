 constexpr const char *ADAPT_TEMPLATE_SUFFIX = ".a";
 
+// New adapted templates for classify, with an empty class for each unichar of
+// its unicharset only when it may adapt: with pre-trained templates to classify
+// with, which an LSTM model has none of, and with learning enabled at the time,
+// which a classifier kept for orientation and script detection never needs. An
+// empty class for each of thousands of unichars took tens of megabytes per
+// engine. Learning must not be enabled later for templates made without it.
+static ADAPT_TEMPLATES_STRUCT *NewAdaptedTemplates(Classify &classify) {
+  static UNICHARSET unadapted;
+  const bool adapts = classify.PreTrainedTemplates != nullptr && classify.classify_enable_learning;
+  return new ADAPT_TEMPLATES_STRUCT(adapts ? classify.unicharset : unadapted);
+}
