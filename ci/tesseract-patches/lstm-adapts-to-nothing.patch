+// New adapted templates, with an empty class for each unichar of unicharset
+// when the classifier adapts at all: without pre-trained templates, as for an
+// LSTM model, it never classifies, and an empty class for each of the
+// thousands of unichars of a CJK model took tens of megabytes per engine.
+static ADAPT_TEMPLATES_STRUCT *NewAdaptedTemplates(UNICHARSET &unicharset,
+                                                   bool adapts) {
+  static UNICHARSET unadapted;
+  return new ADAPT_TEMPLATES_STRUCT(adapts ? unicharset : unadapted);
+}
