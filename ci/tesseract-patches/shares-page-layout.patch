+BLOCK *BLOCK::deep_copy(const BLOCK *source) {
+  ASSERT_HOST(source->paras_.empty());
+  auto *block = new BLOCK;
+  *block = *source;
+  const POLY_BLOCK *polygon = source->pdblk.hand_poly;
+  if (polygon != nullptr) {
+    ICOORDELT_LIST vertices;
+    vertices.deep_copy(const_cast<POLY_BLOCK *>(polygon)->points(), &ICOORDELT::deep_copy);
+    block->pdblk.hand_poly = new POLY_BLOCK(&vertices, polygon->isA());
+  }
+  block->pdblk.index_ = source->pdblk.index_;
+  block->right_to_left_ = source->right_to_left_;
+  block->pitch = source->pitch;
+  block->font_class = source->font_class;
+  block->xheight = source->xheight;
+  block->cell_over_xheight_ = source->cell_over_xheight_;
+  block->median_size_ = source->median_size_;
+  block->c_blobs.deep_copy(&source->c_blobs, &C_BLOB::deep_copy);
+  block->rej_blobs.deep_copy(&source->rej_blobs, &C_BLOB::deep_copy);
+  block->rows.deep_copy(&source->rows, &ROW::deep_copy);
+  return block;
+}
