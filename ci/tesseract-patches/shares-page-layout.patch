+PageLayout::Variables::Variables(Tesseract &tesseract) {
+  const ParamsVectors *params = tesseract.params();
+  ints.reserve(params->int_params.size());
+  for (auto *param : params->int_params) {
+    ints.push_back(*param);
+  }
+  bools.reserve(params->bool_params.size());
+  for (auto *param : params->bool_params) {
+    bools.push_back(*param);
+  }
+  strings.reserve(params->string_params.size());
+  for (auto *param : params->string_params) {
+    strings.emplace_back(param->c_str());
+  }
+  doubles.reserve(params->double_params.size());
+  for (auto *param : params->double_params) {
+    doubles.push_back(*param);
+  }
+}
+
+bool PageLayout::Variables::operator==(const Variables &other) const {
+  return ints == other.ints && bools == other.bools && strings == other.strings &&
+         doubles == other.doubles;
+}
+
+PageLayout::PageLayout(Tesseract &tesseract, const BLOCK_LIST &blocks)
+    : variables_(tesseract)
+    , right_to_left_(tesseract.right_to_left())
+    , single_language_(tesseract.sub_langs_.empty())
+    , pix_binary_(tesseract.pix_binary_.copy())
+    , deskew_(tesseract.deskew_)
+    , reskew_(tesseract.reskew_)
+    , gradient_(tesseract.gradient_) {
+  blocks_.deep_copy(&blocks, &BLOCK::deep_copy);
+}
+
+PageLayout::~PageLayout() {
+  pix_binary_.destroy();
+}
+
+bool PageLayout::Fits(Tesseract &tesseract, int width, int height) const {
+  return single_language_ && tesseract.sub_langs_.empty() &&
+         right_to_left_ == tesseract.right_to_left() &&
+         pixGetWidth(pix_binary_) == width && pixGetHeight(pix_binary_) == height &&
+         variables_ == Variables(tesseract);
+}
+
+void PageLayout::CopyTo(Tesseract &tesseract, BLOCK_LIST *blocks) const {
+  ASSERT_HOST(blocks->empty());
+  tesseract.pix_binary_.destroy();
+  tesseract.pix_binary_ = pix_binary_.copy();
+  tesseract.deskew_ = deskew_;
+  tesseract.reskew_ = reskew_;
+  tesseract.gradient_ = gradient_;
+  blocks->deep_copy(&blocks_, &BLOCK::deep_copy);
 }
 
