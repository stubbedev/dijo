+  tesseract_->set_pix_grey(thresholder_->IsBinary() ? nullptr : thresholder_->GetPixRectGrey());
+  RecordThresholdedGeometry();
+  layout.CopyTo(*tesseract_, block_list_);
+  return RecognizeFoundLines(monitor);
