+++ b/src/api/pagelayout.h
@@ -0,0 +1,75 @@
+///////////////////////////////////////////////////////////////////////
+// File:        pagelayout.h
+// Description: The layout an engine found in an image, for engines of
+//              other languages to recognize the image in.
+//
+// Licensed under the Apache License, Version 2.0 (the "License");
+// you may not use this file except in compliance with the License.
+// You may obtain a copy of the License at
+// http://www.apache.org/licenses/LICENSE-2.0
+// Unless required by applicable law or agreed to in writing, software
+// distributed under the License is distributed on an "AS IS" BASIS,
+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+//
+///////////////////////////////////////////////////////////////////////
+
+#ifndef TESSERACT_API_PAGELAYOUT_H_
+#define TESSERACT_API_PAGELAYOUT_H_
+
+#include "image.h"    // for Image
+#include "ocrblock.h" // for BLOCK_LIST
+#include "points.h"   // for FCOORD
+
+#include <cstdint> // for int32_t
+#include <string>  // for std::string
+#include <vector>  // for std::vector
+
+namespace tesseract {
+
+class Tesseract;
+
+// What an engine found when it found the lines of an image: its blocks with their rows,
+// words and blobs, the binary image the lines it removed are gone from, and the skew of
+// the page, with what decided them besides the image: the engine's variables and the
+// direction of its language.
+class PageLayout {
+public:
+  PageLayout(Tesseract &tesseract, const BLOCK_LIST &blocks);
+  ~PageLayout();
+  PageLayout(const PageLayout &) = delete;
+  PageLayout &operator=(const PageLayout &) = delete;
+
+  // Whether the engine, given an image of the size given, finds this layout in the image
+  // it was found in.
+  bool Fits(Tesseract &tesseract, int width, int height) const;
+
+  // Hands the engine a copy of the layout, as it would have found it, into blocks.
+  void CopyTo(Tesseract &tesseract, BLOCK_LIST *blocks) const;
+
+private:
+  // The values of an engine's variables, in the order every engine declares them.
+  struct Variables {
+    std::vector<int32_t> ints;
+    std::vector<bool> bools;
+    std::vector<std::string> strings;
+    std::vector<double> doubles;
+
+    explicit Variables(Tesseract &tesseract);
+    bool operator==(const Variables &other) const;
+  };
+
+  Variables variables_;
+  bool right_to_left_;
+  bool single_language_;
+  Image pix_binary_;
+  BLOCK_LIST blocks_;
+  FCOORD deskew_;
+  FCOORD reskew_;
+  float gradient_;
+};
+
+} // namespace tesseract
+
+#endif // TESSERACT_API_PAGELAYOUT_H_
