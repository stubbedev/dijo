+void Tesseract::PrereadLSTMWords(const std::vector<WordData> &words, ETEXT_DESC *monitor) {
+  if (lstm_threads <= 1 || lstm_recognizer_ == nullptr ||
+      tessedit_ocr_engine_mode != OEM_LSTM_ONLY || !sub_langs_.empty() || words.size() < 2) {
+    return;
+  }
+  const size_t threads = std::min(static_cast<size_t>(lstm_threads), words.size());
+  std::atomic<size_t> next{0};
+  std::mutex cropping;
+  const auto read = [&](LSTMRecognizer &recognizer) {
+    for (size_t w = next++; w < words.size(); w = next++) {
+      if (monitor != nullptr && monitor->deadline_exceeded()) {
+        return;
+      }
+      const WordData &word = words[w];
+      if (word.word->done || word.lang_words.size() != 1) {
+        continue;
+      }
+      TBOX word_box;
+      std::unique_ptr<ImageData> im_data;
+      {
+        std::lock_guard<std::mutex> lock(cropping);
+        im_data.reset(LSTMWordImage(*word.block, word.row, *word.lang_words[0], &word_box));
+      }
+      if (im_data != nullptr) {
+        LSTMRecognizeWordImage(recognizer, *im_data, word_box, &word.lstm_words);
+      }
+      word.lstm_read = true;
+    }
+  };
+  const auto help = [&]() {
+    LSTMRecognizer helper(language_data_path_prefix.c_str());
+    TessdataManager mgr;
+    if (!mgr.Init((language_data_path_prefix + kTrainedDataSuffix).c_str()) ||
+        !helper.Load(this->params(), lstm_use_matrix ? lang : "", &mgr)) {
+      return;
+    }
+    helper.GetUnicharset().set_black_and_whitelist(tessedit_char_blacklist.c_str(),
+                                                   tessedit_char_whitelist.c_str(),
+                                                   tessedit_char_unblacklist.c_str());
+    helper.SetWordsUnicharset(&lstm_recognizer_->GetUnicharset());
+    read(helper);
+  };
+  std::vector<std::thread> helpers;
+  helpers.reserve(threads - 1);
+  for (size_t t = 1; t < threads; ++t) {
+    helpers.emplace_back(help);
+  }
+  read(*lstm_recognizer_);
+  for (auto &helper : helpers) {
+    helper.join();
+  }
+}
+
 } // namespace tesseract.
