<?xml version="1.0" encoding="UTF-8"?>
<mime-info>
  <mime-type type="application/pgp-encrypted">
    <magic priority="60">
      <match value="-----BEGIN PGP MESSAGE-----" type="string" offset="0:64"/>
    </magic>
  </mime-type>
  <mime-type type="text/x-ssa">
    <sub-class-of type="text/plain"/>
    <glob pattern="*.ssa"/>
    <glob pattern="*.ass"/>
    <magic priority="50">
      <match value="[Script Info]" type="string" offset="0:4"/>
    </magic>
  </mime-type>
  <mime-type type="application/x-ipynb+json">
    <sub-class-of type="application/json"/>
    <glob pattern="*.ipynb"/>
    <magic priority="50">
      <match value="&quot;cells&quot;" type="string" offset="0:64"/>
    </magic>
  </mime-type>
</mime-info>
