<office:body><office:text>
<text:tracked-changes>
<text:changed-region text:id="deleted"><text:deletion><office:change-info><dc:creator>Editor</dc:creator><dc:date>2026-01-05T10:00:00</dc:date></office:change-info><text:p>thin </text:p></text:deletion></text:changed-region>
<text:changed-region text:id="inserted"><text:insertion><office:change-info><dc:creator>Editor</dc:creator><dc:date>2026-01-05T10:01:00</dc:date></office:change-info></text:insertion></text:changed-region>
</text:tracked-changes>
<text:p text:style-name="Standard">The ledger records the lamp<text:span text:style-name="Hidden"> in pencil</text:span> every evening.</text:p>
<text:p text:style-name="Standard">Its entries fill eleven <text:change text:change-id="deleted"/><text:change-start text:change-id="inserted"/>leather <text:change-end text:change-id="inserted"/>volumes.</text:p>
<text:p text:style-name="Standard">Historians found that the plain entries<office:annotation><dc:creator>Reviewer</dc:creator><dc:date>2026-01-06T09:00:00</dc:date><text:p>Cite the archive catalogue here.</text:p></office:annotation> told a richer story.</text:p>
</office:text></office:body></office:document>
